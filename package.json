{
  "name": "ecomlik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "tsc --noEmit && vite build --mode netlify",
    "preview:netlify": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test tests/api.test.ts",
    "test:e2e": "playwright test",
    "test:netlify": "playwright test --config playwright.netlify.config.ts",
    "leads:export": "tsx server/export.ts"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.2.8",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
