# Node 24+ required. Copy this file to .env; never commit credentials.
# These variables are for the optional Node server, not the Netlify Forms build.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/ecomlik.sqlite
# Actual public production origin, required for production form submissions.
PUBLIC_ORIGIN=
# Defaults are the public business settings supplied by the owner.
WHATSAPP_NUMBER=212650291012
# Optional public measurement IDs. Analytics load only after visitor consent.
GA_MEASUREMENT_ID=G-02NN6XJBCT
META_PIXEL_ID=
# Optional HTTPS CRM endpoint. Leads are always saved locally first.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
